---
import BaseLayout from '../layouts/BaseLayout.astro';
import HorizontalStrip from '../components/HorizontalStrip.astro';
import Landing from '../components/Landing.astro';
import Screen from '../components/Screen.astro';
import { desktopSegments, screenById } from '../data/screens';
---

<BaseLayout>
  {
    desktopSegments.map((segment) =>
      segment.type === 'horizontal' ? (
        <HorizontalStrip screens={segment.ids.map(screenById)} />
      ) : (
        segment.ids.map((id) => (id === 'landing' ? <Landing /> : <Screen screen={screenById(id)} />))
      ),
    )
  }
</BaseLayout>
