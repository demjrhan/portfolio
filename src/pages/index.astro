---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserRail from '../components/BrowserRail.astro';
import PageSegment from '../components/PageSegment.astro';
import { browserLastScreen, desktopSegments } from '../data/screens';

const spanEnd =
  desktopSegments.findIndex((segment) => segment.ids.includes(browserLastScreen)) + 1;
const spannedSegments = desktopSegments.slice(0, spanEnd);
const trailingSegments = desktopSegments.slice(spanEnd);
---

<BaseLayout>
  <div class="browser-span">
    <BrowserRail />
    {spannedSegments.map((segment) => <PageSegment segment={segment} />)}
  </div>

  {trailingSegments.map((segment) => <PageSegment segment={segment} />)}
</BaseLayout>

<style>
  .browser-span {
    position: relative;
  }
</style>
