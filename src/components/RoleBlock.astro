---
import { work } from '../data/work';
import { withBase } from '../lib/paths';
import BrandLinks from './BrandLinks.astro';
---

<div class="role">
  <div class="role__header">
    <div class="role__logo">
      <img src={withBase(work.logo.src)} alt={work.logo.alt} width="72" height="72" />
    </div>

    <div class="role__copy">
      <h2 class="role__title">{work.title}</h2>
    </div>
  </div>

  <ul class="role__duties">
    {work.duties.map((duty) => <li>{duty}</li>)}
  </ul>

  <BrandLinks links={work.links} />
</div>

<style>
  .role {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 100%;
  }

  .role__header {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .role__logo {
    display: flex;
    flex: 0 0 auto;
    width: 3.75rem;
    height: 3.75rem;
    overflow: hidden;
    border: 1px solid var(--color-ink);
    border-radius: 0.6rem;
  }

  .role__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .role__copy {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.2rem;
  }

  .role__title {
    margin: 0;
    font-size: clamp(1.5rem, 5.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .role :global(.brand-links) {
    margin-top: auto;
  }

  .role__duties {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role__duties li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 62%, white);
  }

  .role__duties li::before {
    content: '';
    flex: none;
    width: 0.38em;
    height: 0.38em;
    margin-top: 0.52em;
    background: var(--color-ink);
    transform: rotate(45deg);
  }

  .role__duties li + li {
    margin-top: 0.55rem;
  }

  @media (min-width: 768px) {
    .role {
      gap: 1.15rem;
    }

    .role__header {
      gap: 1.1rem;
    }

    .role__logo {
      width: 4.125rem;
      height: 4.125rem;
    }

    .role__title {
      font-size: clamp(1.75rem, 2.8vw, 2.15rem);
    }

    .role__duties li {
      font-size: 1rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 1280px) {
    .role {
      gap: 1.25rem;
    }

    .role__header {
      gap: 1.2rem;
    }

    .role__logo {
      width: 4.5rem;
      height: 4.5rem;
      border-radius: 0.7rem;
    }

    .role__title {
      font-size: clamp(1.8rem, 2vw, 2.25rem);
    }

    .role__duties li {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
</style>
