---
interface Link {
  label: string;
  icon: 'website' | 'linkedin';
  href: string;
}

interface Props {
  links: readonly Link[];
}

const { links } = Astro.props;
---

<ul class="brand-links">
  {
    links.map((link) => (
      <li>
        <a
          class="brand-links__link"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          data-icon={link.icon}
        >
          {link.icon === 'linkedin' ? (
            <svg class="brand-links__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0Z"
              />
            </svg>
          ) : (
            <svg class="brand-links__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.4 9h-3.18a15.4 15.4 0 0 0-1.36-6.02A8.03 8.03 0 0 1 19.4 11ZM12 4c.9 1.3 1.6 3.05 1.96 5H10.04C10.4 7.05 11.1 5.3 12 4ZM4.6 13h3.18c.16 2.14.64 4.12 1.36 6.02A8.03 8.03 0 0 1 4.6 13Zm3.18-2H4.6a8.03 8.03 0 0 1 4.54-6.02A15.4 15.4 0 0 0 7.78 11Zm4.22 9c-.9-1.3-1.6-3.05-1.96-5h3.92C13.6 16.95 12.9 18.7 12 20Zm1.92-7H10.08a13.7 13.7 0 0 1 1.92-5.7 13.7 13.7 0 0 1 1.92 5.7Zm.14 8.02A15.4 15.4 0 0 0 16.22 13h3.18a8.03 8.03 0 0 1-4.54 6.02Z"
              />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .brand-links {
    display: flex;
    align-items: center;
    align-self: flex-end;
    justify-content: flex-end;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-links__link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .brand-links__icon {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    fill: currentColor;
  }

  .brand-links__link:hover,
  .brand-links__link:focus-visible {
    color: var(--color-accent);
  }

  .brand-links__link[data-icon='website']:hover,
  .brand-links__link[data-icon='website']:focus-visible {
    color: var(--color-coral);
  }

  .brand-links__link[data-icon='linkedin']:hover,
  .brand-links__link[data-icon='linkedin']:focus-visible {
    color: var(--color-purple);
  }
</style>
