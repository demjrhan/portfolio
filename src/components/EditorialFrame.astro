---
import RoleBlock from './RoleBlock.astro';
import SchoolBlock from './SchoolBlock.astro';
---

<article class="editorial-frame" aria-label="Page 1">
  <div class="editorial-frame__cell editorial-frame__primary"></div>

  <div class="editorial-frame__cell editorial-frame__right-top">
    <RoleBlock />
  </div>

  <div class="editorial-frame__cell editorial-frame__right-bottom">
    <SchoolBlock />
  </div>
</article>

<style>
  .editorial-frame {
    --frame-line: 1px solid var(--color-ink);
    --frame-radius: 1.5rem;
    --frame-pad: 1.5rem;

    display: grid;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border: var(--frame-line);
    border-radius: var(--frame-radius);
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    grid-template-areas:
      'primary'
      'right-top'
      'right-bottom';
  }

  .editorial-frame__cell {
    position: relative;
    padding: var(--frame-pad);
  }

  .editorial-frame__primary {
    grid-area: primary;
    min-height: min(12rem, 28svh);
    border-bottom: var(--frame-line);
  }

  .editorial-frame__right-top {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.75rem;
    grid-area: right-top;
    border-bottom: var(--frame-line);
  }

  .editorial-frame__right-bottom {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.75rem;
    grid-area: right-bottom;
    min-height: 0;
  }

  @media (min-width: 768px) {
    .editorial-frame {
      --frame-pad: 2rem;
      --frame-radius: 1.75rem;
      grid-template-columns: 3fr 2fr;
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas:
        'primary right-top'
        'primary right-bottom';
    }

    .editorial-frame__primary {
      min-height: 0;
      border-right: var(--frame-line);
      border-bottom: none;
    }
  }

  @media (min-width: 1280px) {
    .editorial-frame {
      --frame-pad: 2.5rem;
      --frame-radius: 2rem;
    }
  }
</style>
