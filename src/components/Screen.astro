---
import GradientBackground from './GradientBackground.astro';
import type { Screen } from '../data/screens';

interface Props {
  screen: Screen;
}

const { screen } = Astro.props;

const tones: Record<Screen['tone'], string> = {
  'dark-gray': 'bg-dark-gray',
  white: 'bg-paper',
  yellow: 'bg-yellow',
};
---

<section
  id={screen.id}
  class:list={[
    'relative isolate flex min-h-svh w-full flex-col snap-start overflow-hidden',
    screen.gradient ? null : tones[screen.tone],
  ]}
  aria-label={screen.id}
>
  {screen.gradient && <GradientBackground variant={screen.gradient} />}
  <slot />
</section>
