---
import { education, type School } from '../data/education';
import { withBase } from '../lib/paths';
import BrandLinks from './BrandLinks.astro';

interface Props {
  school?: School;
}

const { school = education } = Astro.props;
---

<div class="school">
  <div class="school__header">
    <div class="school__logo">
      <img src={withBase(school.logo.src)} alt={school.logo.alt} width="72" height="72" />
    </div>
    <div class="school__copy">
      <h2 class="school__title">{school.title}</h2>
      {school.degree && <p class="school__degree">{school.degree}</p>}
      <div class="school__line">
        <p class="school__dates">{school.dates}</p>
        {school.grade && <p class="school__detail">{school.grade}</p>}
      </div>
      {school.description && <p class="school__description">{school.description}</p>}
      {
        school.duties && (
          <ul class="school__duties">
            {school.duties.map((duty) => (
              <li>{duty}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <BrandLinks links={school.links} />
</div>

<style>
  .school {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 100%;
  }

  .school__header {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .school__logo {
    display: flex;
    flex: 0 0 auto;
    width: 3.75rem;
    height: 3.75rem;
    overflow: hidden;
    border-radius: 0.6rem;
  }

  .school__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .school__copy {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.35rem;
  }

  .school__title {
    margin: 0 0 0 -0.2rem;
    font-size: clamp(1.5rem, 5.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .school__degree {
    margin: 0;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .school__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.25rem;
    width: 100%;
  }

  .school__dates {
    margin: 0;
    flex: none;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .school__detail {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .school__description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 62%, white);
  }

  .school__duties {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .school__duties li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-left: calc(-0.38em - 0.6rem);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 62%, white);
  }

  .school__duties li::before {
    content: '';
    flex: none;
    width: 0.38em;
    height: 0.38em;
    margin-top: 0.52em;
    background: var(--color-ink);
    transform: rotate(45deg);
  }

  .school__duties li + li {
    margin-top: 0.55rem;
  }

  .school__meta {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ink) 62%, white);
  }

  .school :global(.brand-links) {
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .school__header {
      gap: 1.1rem;
    }

    .school__logo {
      width: 4.125rem;
      height: 4.125rem;
    }

    .school__title {
      font-size: clamp(1.75rem, 2.8vw, 2.15rem);
    }

    .school__duties li {
      font-size: 1rem;
      line-height: 1.5;
    }
  }

  @media (min-width: 1280px) {
    .school__header {
      gap: 1.2rem;
    }

    .school__logo {
      width: 4.5rem;
      height: 4.5rem;
      border-radius: 0.7rem;
    }

    .school__title {
      font-size: clamp(1.8rem, 2vw, 2.25rem);
    }

    .school__degree,
    .school__dates {
      font-size: 1rem;
    }

    .school__meta {
      font-size: 0.9375rem;
    }

    .school__duties li {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
</style>
