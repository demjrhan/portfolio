---
import { education } from '../data/education';
import { withBase } from '../lib/paths';
import BrandLinks from './BrandLinks.astro';
---

<div class="school">
  <div class="school__header">
    <div class="school__logo">
      <img src={withBase(education.logo.src)} alt={education.logo.alt} width="72" height="72" />
    </div>
    <div class="school__copy">
      <h2 class="school__title">{education.title}</h2>
      <p class="school__degree">{education.degree}</p>
      <div class="school__line">
        <p class="school__detail">{education.dates}</p>
        <p class="school__detail">{education.grade}</p>
      </div>
    </div>
  </div>

  <BrandLinks links={education.links} />
</div>

<style>
  .school {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 100%;
  }

  .school__header {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .school__logo {
    display: flex;
    flex: 0 0 auto;
    width: 3.75rem;
    height: 3.75rem;
    overflow: hidden;
    border-radius: 0.6rem;
  }

  .school__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .school__copy {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.35rem;
  }

  .school__title {
    margin: 0;
    font-size: clamp(1.5rem, 5.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .school__degree {
    margin: 0;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .school__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.25rem;
    width: 100%;
  }

  .school__dates {
    margin: 0 0 0 auto;
    flex: none;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    white-space: nowrap;
  }

  .school__meta {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ink) 62%, white);
  }

  .school :global(.brand-links) {
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .school__header {
      gap: 1.1rem;
    }

    .school__logo {
      width: 4.125rem;
      height: 4.125rem;
    }

    .school__title {
      font-size: clamp(1.75rem, 2.8vw, 2.15rem);
    }
  }

  @media (min-width: 1280px) {
    .school__header {
      gap: 1.2rem;
    }

    .school__logo {
      width: 4.5rem;
      height: 4.5rem;
      border-radius: 0.7rem;
    }

    .school__title {
      font-size: clamp(1.8rem, 2vw, 2.25rem);
    }

    .school__degree,
    .school__dates {
      font-size: 1rem;
    }

    .school__meta {
      font-size: 0.9375rem;
    }
  }
</style>
