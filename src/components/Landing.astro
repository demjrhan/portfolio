---
import BrowserWindow from './BrowserWindow.astro';
import EditorialFrame from './EditorialFrame.astro';
import GradientGlobe from './GradientGlobe.astro';
---

<section
  id="landing"
  class="landing relative flex min-h-svh w-full flex-col snap-start overflow-x-hidden bg-paper max-[1279px]:h-auto min-[1280px]:overflow-hidden"
  aria-label="Landing"
>
  <GradientGlobe />

  <div
    class="landing__stage relative z-10 flex min-h-0 flex-1 flex-col px-6 pt-[max(1.25rem,env(safe-area-inset-top))] pb-0 min-[768px]:px-12 min-[768px]:pt-8 min-[1280px]:px-28 min-[1280px]:pt-14"
  >
    <div class="landing__browser">
      <BrowserWindow />
    </div>

    <EditorialFrame />
  </div>
</section>

<style>
  .landing__browser {
    flex: 0 0 auto;
    width: 100%;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .landing__browser {
      --browser-aspect: 2 / 1;

      margin-bottom: 1rem;
    }
  }

  /* Desktop places the window inside the empty left column of the grid, so the
     offsets mirror the landing padding and the grid ratio in EditorialGrid. */
  @media (min-width: 1280px) {
    .landing__browser {
      --browser-aspect: auto;
      --landing-pad-x: 7rem;
      --landing-pad-top: 3.5rem;
      --frame-inset: 2.5rem;
      --primary-share: 0.6;

      position: absolute;
      top: calc(var(--landing-pad-top) + var(--frame-inset));
      left: calc(var(--landing-pad-x) + var(--frame-inset));
      width: calc(
        var(--primary-share) * (100% - 2 * var(--landing-pad-x)) - 2 * var(--frame-inset)
      );
      height: calc(100svh - var(--landing-pad-top) - var(--frame-inset) - 3rem);
      margin: 0;
    }
  }
</style>
