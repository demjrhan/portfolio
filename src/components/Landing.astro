---
import EditorialFrame from './EditorialFrame.astro';
import GradientGlobe from './GradientGlobe.astro';
---

<section
  id="landing"
  class="landing relative flex min-h-svh w-full flex-col snap-start overflow-hidden bg-paper"
  aria-label="Landing"
>
  <GradientGlobe />

  <div
    class="relative z-10 flex min-h-0 flex-1 flex-col px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-[max(1rem,env(safe-area-inset-bottom))] min-[768px]:px-8 min-[1280px]:px-12"
  >
    <div class="flex items-center pt-1" aria-hidden="true">
      <div class="flex flex-col gap-1.5">
        <span class="block h-0.5 w-5 rounded-full bg-ink min-[768px]:h-[3px] min-[768px]:w-6"></span>
        <span class="block h-0.5 w-5 rounded-full bg-ink min-[768px]:h-[3px] min-[768px]:w-6"></span>
      </div>
    </div>
    <EditorialFrame />
  </div>
</section>
