---
import EditorialFrame from './EditorialFrame.astro';
import GradientGlobe from './GradientGlobe.astro';
---

<section
  id="landing"
  class="landing relative flex min-h-svh w-full flex-col snap-start overflow-hidden bg-paper"
  aria-label="Landing"
>
  <GradientGlobe />

  <div
    class="relative z-10 flex min-h-0 flex-1 flex-col px-6 pt-[max(1.25rem,env(safe-area-inset-top))] pb-[max(1.25rem,env(safe-area-inset-bottom))] min-[768px]:px-12 min-[768px]:py-8 min-[1280px]:px-28 min-[1280px]:py-14"
  >
    <EditorialFrame />
  </div>
</section>
